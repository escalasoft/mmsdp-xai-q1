{
  "experiment_version": "qt-unimodal-baselines-1.0.0",
  "fit_partition": "train",
  "evaluation_partitions": ["train", "validation"],
  "sealed_partition": "test",
  "modalities": ["CODE", "PROCESS", "TEXT"],
  "models": {
    "LR": {
      "class": "sklearn.linear_model.LogisticRegression",
      "hyperparameters": {
        "C": 1.0,
        "class_weight": null,
        "fit_intercept": true,
        "max_iter": 1000,
        "random_state": 0,
        "solver": "lbfgs",
        "tol": 0.0001
      }
    },
    "RF": {
      "class": "sklearn.ensemble.RandomForestClassifier",
      "hyperparameters": {
        "bootstrap": true,
        "class_weight": null,
        "criterion": "gini",
        "max_depth": null,
        "max_features": "sqrt",
        "min_samples_leaf": 1,
        "min_samples_split": 2,
        "n_estimators": 100,
        "random_state": 0
      }
    }
  },
  "positive_label": 1,
  "decision_threshold": 0.5,
  "threshold_policy": "fixed-conventional-baseline-no-validation-optimization",
  "imbalance_policy": "no-resampling-and-no-class-weighting",
  "prohibited_operations": [
    "test-predictive-evaluation",
    "multimodal-fusion",
    "calibration",
    "xai",
    "feature-selection",
    "hyperparameter-search",
    "train-validation-refit"
  ]
}
